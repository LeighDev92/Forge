      <memberdef kind="function" id="class_forge_1_1_application_1a557048578ee7590df9af6fb6d296671e" prot="public" static="no" const="no" explicit="no" inline="no" virt="virtual">
        <type>int</type>
        <definition>virtual int Forge::Application::Run</definition>
        <argsstring>()</argsstring>
        <name>Run</name>
        <qualifiedname>Forge::Application::Run</qualifiedname>
        <briefdescription>
<para>Executes the main application loop. </para>
        </briefdescription>
        <detaileddescription>
<para>Processes pending Windows messages, handles accelerator keys, and executes the application&apos;s frame lifecycle while the application is running.</para>
<para>Each frame calculates the elapsed time since the previous frame and calls <ref refid="class_forge_1_1_application_1a56405fedf64cdb1ceb66704344726aab" kindref="member">BeginFrame()</ref> followed by <ref refid="class_forge_1_1_application_1a9801fed5a657923b6951bc335ca05f4f" kindref="member">EndFrame()</ref>.</para>
<para>The loop terminates when a WM_QUIT message is received.</para>
<para><simplesect kind="return"><para>The exit code supplied by the WM_QUIT message. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="Include/Application.h" line="72" column="13"/>
      </memberdef>
